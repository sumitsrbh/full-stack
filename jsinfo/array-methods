let users = [
  { name: 'dummy', age: 34 },
  { name: 'lolo', age: 56 },
  { name: 'dumka', age: 59 },
  { name: 'chand', age: 3 },
  { name: 'raunak', age: 13 },
]
let new_users = console.log(
  users.find((user) => user.age > 18),
  'Index',
  users.findIndex((user) => user.age > 18)
) // first matching user returned and then iteration stops

// return the whole matching array
console.log(users.filter((user) => user.age > 18))

function sum(num) {
  return num * 2
}
function names(input) {
  return input.age > 18 ? input.name : null
}
console.log(array.map((item) => sum(item)))
console.log(users.map((user) => names(user)))

